<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" version="4.0">

    <welcome-file-list>
        <welcome-file>tp1.html</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>FormServlet</servlet-name>
        <servlet-class>Ser.Servlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FormServlet</servlet-name>
        <url-pattern>/FormServlet</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>ReadCookie</servlet-name>
        <servlet-class>Ser.ReadCookie</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReadCookie</servlet-name>
        <url-pattern>/ReadCookie</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VisitCounter</servlet-name>
        <servlet-class>Ser.VisitCounter</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VisitCounter</servlet-name>
        <url-pattern>/VisitCounter</url-pattern>
    </servlet-mapping>
</web-app>